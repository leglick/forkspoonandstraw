---
import { CATEGORIES } from '../lib/categories';

// Subtitle copy is presentation-only (not part of the shared category data
// used for routing/labels elsewhere), so it lives here rather than in
// src/lib/categories.ts.
const SUBTITLES: Record<string, { mobile: string; desktop: string }> = {
  food: { mobile: 'recipes, markets & the good stuff', desktop: 'recipes, markets & the good stuff' },
  travel: { mobile: 'stamps in my passport', desktop: 'stamps in my passport' },
  'touloused-confused': { mobile: 'my city, my tables', desktop: 'my city, my tables' },
  'pardon-my-franglais': { mobile: 'the beautiful expat mess', desktop: 'the beautiful expat mess' },
};
---

<div class="category-grid">
  {
    CATEGORIES.map((c) => (
      <a class="category-card" data-accent={c.accent} href={`/${c.slug}`}>
        <span class="category-title">{c.label}</span>
        <span class="category-subtitle subtitle-mobile">{SUBTITLES[c.slug]?.mobile}</span>
        <span class="category-subtitle subtitle-desktop">{SUBTITLES[c.slug]?.desktop}</span>
      </a>
    ))
  }
</div>

<style>
  .category-grid {
    padding: var(--sp-20) var(--gutter-card) var(--sp-22);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-10);
  }

  .category-card {
    border-radius: 16px;
    background: var(--creme);
    border: 1px solid var(--fleur-de-sel);
    border-left: 3px solid var(--roquefort);
    padding: var(--sp-14);
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-decoration: none;
    transition:
      transform 150ms ease-out,
      box-shadow 150ms ease-out;
  }

  .category-card[data-accent='saumon'] {
    border-left-color: var(--saumon);
  }

  .category-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .category-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 19px;
    line-height: 1.12;
    color: var(--espresso);
  }

  .category-subtitle {
    font-size: 11px;
    color: var(--truffle);
  }

  .subtitle-desktop {
    display: none;
  }

  @media (min-width: 900px) {
    .category-grid {
      margin-top: -52px;
      padding: 0 var(--gutter-desktop);
      max-width: 1280px;
      margin-inline: auto;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      position: relative;
      z-index: 6;
    }

    .category-card {
      border-radius: var(--radius-grid-card);
      box-shadow: var(--shadow-card);
      padding: var(--sp-20);
      gap: 5px;
    }

    .category-title {
      font-size: 24px;
    }

    .subtitle-mobile {
      display: none;
    }

    .subtitle-desktop {
      display: block;
      font-family: var(--font-serif);
      font-size: 15px;
    }
  }
</style>
