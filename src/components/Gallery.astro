---
// Horizontal scrollable photo gallery.
//
// Usage (inside a post's index.mdx):
//   <Gallery post="mantesino-italy" folder="mantesino" />
//
// `post` is the post's slug (its content/posts/<slug> directory name) and
// `folder` is the subfolder under that post's images/ directory. Astro's
// import.meta.glob pattern below must stay a static string literal, so we
// glob every post's images once and filter down to the requested pair —
// there's no way to inject `post`/`folder` into the glob pattern itself.
import { Image } from 'astro:assets';

interface Props {
  post: string;
  folder: string;
}

const { post, folder } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/posts/*/images/*/*.{jpeg,jpg,png,webp,avif}',
  { eager: true }
);

const prefix = `/src/content/posts/${post}/images/${folder}/`;

const images = Object.entries(allImages)
  .filter(([path]) => path.startsWith(prefix))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

{
  images.length === 0 ? (
    <p class="gallery-empty">No images found in "{folder}" for post "{post}".</p>
  ) : (
    <div class="gallery-wrap">
      <div class="gallery-scroll" role="group" aria-label={`Photo gallery: ${folder}`}>
        {images.map((src) => (
          <div class="gallery-item">
            <Image src={src} alt="" width={520} height={648} loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
      <div class="gallery-footer">
        <span class="gallery-caption">
          swipe &mdash; {images.length} photo{images.length === 1 ? '' : 's'}
        </span>
        <div class="gallery-track">
          <div class="gallery-bar" />
        </div>
      </div>
    </div>
  )
}

<script>
  // Progressive enhancement only: the gallery is a plain CSS scroll-snap
  // list without this. JS just paints a progress bar tracking
  // scrollLeft / scrollWidth per gallery instance on the page.
  document.querySelectorAll<HTMLElement>('.gallery-scroll').forEach((scroller) => {
    const bar = scroller.parentElement?.querySelector<HTMLElement>('.gallery-bar');
    if (!bar) return;

    function update() {
      const max = scroller.scrollWidth - scroller.clientWidth;
      const pct = max > 0 ? (scroller.scrollLeft / max) * 100 : 100;
      bar!.style.width = `${pct}%`;
    }

    scroller.addEventListener('scroll', update, { passive: true });
    update();
  });
</script>

<style>
  .gallery-wrap {
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
    max-width: 100vw;
    background: var(--creme);
    padding: var(--sp-14) 0 var(--sp-8);
    margin-block: var(--sp-20);
  }

  .gallery-scroll {
    display: flex;
    gap: 9px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-left: var(--gutter-text);
    padding-right: var(--gutter-text);
    /* Without this, scroll-snap-align:start on the items doesn't know the
       padding is a valid resting position, and some instances on the page
       auto-scroll themselves on load to snap the first item flush against
       the scrollport edge -- fighting the padding rather than resting at it. */
    scroll-padding-left: var(--gutter-text);
    scroll-padding-right: var(--gutter-text);
    -webkit-overflow-scrolling: touch;
  }

  .gallery-item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: 170px;
    height: 212px;
    border-radius: var(--radius-thumb);
    overflow: hidden;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-empty {
    color: var(--truffle);
    font-style: italic;
  }

  .gallery-footer {
    padding: 12px var(--gutter-text) 0;
    display: flex;
    align-items: center;
    gap: var(--sp-10);
  }

  .gallery-caption {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--roquefort);
    white-space: nowrap;
  }

  .gallery-track {
    flex: 1;
    height: 2px;
    background: rgba(91, 125, 143, 0.22);
  }

  .gallery-bar {
    height: 100%;
    width: 0%;
    background: var(--roquefort);
  }

  @media (min-width: 900px) {
    .gallery-item {
      width: 260px;
      height: 324px;
    }

    /* .gallery-wrap bleeds to 100vw, so a fixed gutter-text inset left the
       row starting way left of the --measure text column above/below it.
       This matches that column's actual margin at any viewport width. */
    .gallery-scroll {
      padding-left: calc((100vw - var(--measure)) / 2);
      padding-right: calc((100vw - var(--measure)) / 2);
      scroll-padding-left: calc((100vw - var(--measure)) / 2);
      scroll-padding-right: calc((100vw - var(--measure)) / 2);
    }

    .gallery-footer {
      padding-left: calc((100vw - var(--measure)) / 2);
      padding-right: calc((100vw - var(--measure)) / 2);
    }
  }
</style>
