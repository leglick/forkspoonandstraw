---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, cover, categories } = post.data;
---

<a class="read-next" href={`/posts/${post.data.slug}`}>
  <span class="read-next-label">Read next</span>
  <div class="read-next-row">
    <div class="read-next-thumb">
      <Image src={cover} alt="" width={156} height={156} />
    </div>
    <div class="read-next-stack">
      <span class="read-next-category">{categories[0]}</span>
      <span class="read-next-title">{title}</span>
    </div>
  </div>
</a>

<style>
  .read-next {
    display: flex;
    flex-direction: column;
    gap: var(--sp-14);
    padding: var(--sp-22);
    border-top: 1px solid var(--fleur-de-sel);
    margin-top: var(--sp-18);
    text-decoration: none;
    color: inherit;
  }

  .read-next-label {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--roquefort);
  }

  .read-next-row {
    display: flex;
    gap: 13px;
    align-items: center;
  }

  .read-next-thumb {
    width: 78px;
    height: 78px;
    flex-shrink: 0;
    border-radius: var(--radius-thumb);
    overflow: hidden;
  }

  .read-next-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .read-next-stack {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .read-next-category {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paprika);
  }

  .read-next-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 20px;
    line-height: 1.1;
    color: var(--espresso);
  }
</style>
