---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import defaultOgImage from '../header_final.jpeg';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  mastheadVariant?: 'home' | 'default' | 'post';
  tagline?: string;
  back?: { label: string; href: string };
  sticky?: boolean;
  image?: ImageMetadata;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'A food and travel blog.',
  mastheadVariant = 'default',
  tagline,
  back,
  sticky = false,
  image = defaultOgImage,
  ogType = 'website',
} = Astro.props;

// A single 1200-wide render covers OG/Twitter cards for every page (post
// covers and the default header photo alike); social crawlers don't need
// the responsive srcset treatment astro:assets does for on-page <Image>s.
const ogImage = await getImage({ src: image, width: 1200, height: Math.round(1200 * (image.height / image.width)) });
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Fork Spoon & Straw" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Fork Spoon & Straw" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <Masthead variant={mastheadVariant} tagline={tagline} back={back} sticky={sticky} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
