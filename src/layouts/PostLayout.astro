---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TagRow from '../components/TagRow.astro';
import Signoff from '../components/Signoff.astro';
import ReadNext from '../components/ReadNext.astro';
import Gallery from '../components/Gallery.astro';
import { getCategorySlug } from '../lib/categories';
import { splitPostBody, renderMarkdown } from '../lib/markdown';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, date, cover, categories, tags, readTime } = post.data;

// Posts are plain .md (Obsidian can't edit .mdx), so `:::gallery{folder="x"}`
// markers and standalone `![alt](./relative.jpg)` images are split out of
// the raw body here and rendered as real <Gallery>/<Image> components
// between markdown chunks, rather than relying on MDX component embedding
// or Astro's normal Content rendering (which is what would otherwise
// optimize inline markdown images automatically). See src/lib/markdown.ts.
const allPostImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/posts/*/images/**/*.{jpeg,jpg,png,webp,avif}',
  { eager: true }
);

function resolveInlineImage(path: string) {
  return allPostImages[`/src/content/posts/${post.data.slug}/${path}`]?.default;
}

const segments = await Promise.all(
  splitPostBody(post.body ?? '').map(async (segment) => {
    if (segment.type === 'gallery') return segment;
    if (segment.type === 'image') {
      const resolved = resolveInlineImage(segment.path);
      if (!resolved) {
        console.warn(`[PostLayout] "${post.data.slug}": inline image "./${segment.path}" not found, skipping.`);
      }
      return { ...segment, resolved };
    }
    return { ...segment, html: await renderMarkdown(segment.markdown) };
  })
);

// Hero is inset to the same 680px text column as the rest of the post (not
// full-bleed), cropped to a fixed 3:2 landscape. Request Astro-side
// dimensions matching that ratio -- requesting the source's own proportions
// instead would make Astro's image service crop to a different box than the
// CSS aspect-ratio below expects, fighting the intended crop.
const HERO_WIDTH = 1440;
const HERO_HEIGHT = Math.round((HERO_WIDTH * 2) / 3);

const dateLabel = date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const currentIndex = allPosts.findIndex((p) => p.data.slug === post.data.slug);
const defaultNextPost = allPosts[(currentIndex + 1) % allPosts.length];
const overrideNextPost = post.data.readNext
  ? allPosts.find((p) => p.data.slug === post.data.readNext)
  : undefined;
if (post.data.readNext && !overrideNextPost) {
  console.warn(
    `[PostLayout] "${post.data.slug}" has readNext: "${post.data.readNext}", but no post with that slug exists. Falling back to the default pick.`
  );
}
const nextPost = overrideNextPost ?? defaultNextPost;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: new URL(cover.src, Astro.site).toString(),
  datePublished: date.toISOString(),
  author: { '@type': 'Organization', name: 'Fork Spoon & Straw' },
  publisher: {
    '@type': 'Organization',
    name: 'Fork Spoon & Straw',
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).toString() },
  },
  mainEntityOfPage: canonicalURL.toString(),
};
---

<BaseLayout
  title={`${title} · Fork Spoon & Straw`}
  description={description}
  mastheadVariant="post"
  back={{ label: categories[0] ?? 'Home', href: categories[0] ? `/${getCategorySlug(categories[0])}` : '/' }}
  image={cover}
  ogType="article"
  sticky
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <article class="post">
    <header class="post-header">
      <span class="post-pill">{categories[0]}</span>
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-dek">{description}</p>}
      <div class="post-meta">
        <span>{dateLabel}</span>
        <span class="meta-dot" aria-hidden="true"></span>
        <span>{readTime} min read</span>
      </div>
    </header>

    <div class="post-hero">
      <Image src={cover} alt="" width={HERO_WIDTH} height={HERO_HEIGHT} priority />
    </div>

    <div class="prose">
      {
        segments.map((segment) => {
          if (segment.type === 'gallery') {
            return <Gallery post={post.data.slug} folder={segment.folder} />;
          }
          if (segment.type === 'image') {
            if (!segment.resolved) return null;
            // Matches the same COVER_MAX_WIDTH-style logic as the hero: cap
            // at 2x the 680px prose column, keep the source's own aspect
            // ratio (CSS-side height:auto handles the rest -- see the
            // global img,picture reset).
            const width = Math.min(segment.resolved.width, 1360);
            const height = Math.round(width * (segment.resolved.height / segment.resolved.width));
            return <Image src={segment.resolved} alt={segment.alt} width={width} height={height} loading="lazy" />;
          }
          return <Fragment set:html={segment.html} />;
        })
      }
    </div>

    <div class="post-footer">
      <TagRow tags={tags} />
      <Signoff />
    </div>

    {nextPost && <ReadNext post={nextPost} />}
  </article>
</BaseLayout>

<style>
  /* The creme "paper" is full-bleed (like home's cast-iron bands) while the
     text itself stays capped at --measure; without this the paper reads as
     a narrow island floating in the sand background on wide desktops. */
  .post {
    position: relative;
    max-width: var(--measure);
    margin-inline: auto;
  }

  .post::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--creme);
    z-index: -1;
  }

  .post-header {
    padding: var(--sp-22) var(--gutter-text) var(--sp-18);
    display: flex;
    flex-direction: column;
    gap: var(--sp-10);
  }

  .post-pill {
    align-self: flex-start;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--roquefort);
    color: var(--creme);
    padding: 6px 11px;
    border-radius: var(--radius-pill);
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    font-size: 36px;
    line-height: 0.99;
    color: var(--espresso);
    margin: 0;
  }

  .post-dek {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.32;
    color: var(--roquefort-ink);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-10);
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--truffle);
  }

  .meta-dot {
    width: 4px;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--roquefort);
  }

  .post-hero {
    padding-inline: var(--gutter-text);
  }

  .post-hero :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-thumb);
    display: block;
  }

  .prose {
    padding: var(--sp-26) var(--gutter-text) 6px;
  }

  .post-footer {
    padding: var(--sp-20) var(--gutter-text) 8px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-14);
  }

  @media (min-width: 900px) {
    .post-header {
      padding-inline: 0;
    }

    .post-title {
      font-size: 52px;
      line-height: 1.03;
    }

    .post-hero {
      padding-inline: 0;
    }

    .prose {
      padding-inline: 0;
    }

    .post-footer {
      padding-inline: 0;
    }
  }
</style>
