---
// Category dek copy is short editorial framing (not personal/biographical
// claims), written to match the site's voice -- same spirit as the
// CategoryGrid subtitles. No filter-chip taxonomy exists in the content
// model (tags are sparse/inconsistent across posts), so that mockup feature
// is intentionally omitted here rather than faked with invented filters.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategorySlug, getCategoryLabel } from '../lib/categories';

const DEKS: Record<string, string> = {
  food: "Things I've made, things I've eaten, things I'd make you try.",
  travel: "Where I've been, and the stories (and snacks!) I brought home.",
  'touloused-confused': 'The city, the tables, my unsolicited Toulouse opinions.',
  'pardon-my-franglais': 'Expat life, in two languages, sometimes at the same time.',
};

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const slugs = [...new Set(allPosts.flatMap((p) => p.data.categories.map(getCategorySlug)))];

  return slugs.map((slug) => ({
    params: { category: slug },
    props: {
      posts: allPosts
        .filter((p) => p.data.categories.some((c) => getCategorySlug(c) === slug))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { category: slug } = Astro.params;
const { posts } = Astro.props;
const label = getCategoryLabel(slug);
const dek = DEKS[slug];

const [featured, ...rest] = posts;
---

<BaseLayout
  title={`${label} · Fork Spoon & Straw`}
  description={dek ?? `Posts in ${label}.`}
  mastheadVariant="default"
>
  <header class="archive-header">
    <div class="eyebrow-row">
      <div class="rule"></div>
      <span class="eyebrow">Cat&eacute;gorie</span>
    </div>
    <h1 class="archive-title">{label}</h1>
    {dek && <p class="archive-dek">{dek}</p>}
    <span class="archive-count">
      {posts.length} {posts.length === 1 ? 'entry' : 'entries'}
    </span>
  </header>

  {
    featured && (
      <div class="featured-wrap">
        <a class="featured-card" href={`/posts/${featured.data.slug}`}>
          <div class="featured-cover">
            <Image src={featured.data.cover} alt="" width={640} height={230} />
          </div>
          <div class="featured-body">
            <span class="featured-pill">Coup de coeur</span>
            <h2 class="featured-title">{featured.data.title}</h2>
            <p class="featured-dek">{featured.data.description}</p>
            <span class="featured-meta">
              {String(featured.data.date.getDate()).padStart(2, '0')}.
              {String(featured.data.date.getMonth() + 1).padStart(2, '0')} &middot; {featured.data.readTime} min
            </span>
          </div>
        </a>
      </div>
    )
  }

  {
    rest.length > 0 && (
      <Fragment>
        <div class="everything-else-rule">
          <span>Everything else</span>
          <div class="rule-line" />
        </div>
        <div class="thumb-rows">
          {rest.map((post) => (
            <a class="thumb-row" href={`/posts/${post.data.slug}`}>
              <div class="thumb">
                <Image src={post.data.cover} alt="" width={100} height={126} />
              </div>
              <div class="thumb-stack">
                <span class="thumb-meta">
                  {String(post.data.date.getDate()).padStart(2, '0')}.
                  {String(post.data.date.getMonth() + 1).padStart(2, '0')} &middot; {post.data.readTime} min
                </span>
                <span class="thumb-title">{post.data.title}</span>
                <span class="thumb-dek">{post.data.description}</span>
              </div>
            </a>
          ))}
        </div>
      </Fragment>
    )
  }
</BaseLayout>

<style>
  /* Full-bleed cast-iron band behind the capped text column -- see the same
     trick on PostLayout's .post; otherwise this reads as a narrow island
     floating in the sand background on wide desktops. */
  .archive-header {
    position: relative;
    padding: 0 var(--sp-18) var(--sp-26);
    display: flex;
    flex-direction: column;
    gap: var(--sp-10);
  }

  .archive-header::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--cast-iron);
    z-index: -1;
  }

  .eyebrow-row {
    display: flex;
    align-items: center;
    gap: var(--sp-10);
  }

  .rule {
    width: var(--sp-26);
    height: 2px;
    background: var(--sea-salt);
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sea-salt);
  }

  .archive-title {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.035em;
    font-size: 38px;
    line-height: 0.98;
    color: var(--creme);
    margin: 0;
    text-transform: capitalize;
  }

  .archive-dek {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.4;
    color: rgba(253, 250, 244, 0.82);
    max-width: var(--measure);
  }

  .archive-count {
    font-family: var(--font-sans);
    font-size: 12px;
    color: rgba(253, 250, 244, 0.55);
  }

  .featured-wrap {
    padding: var(--sp-18) var(--gutter-card);
  }

  .featured-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-card);
    background: var(--creme);
    border: 1px solid var(--fleur-de-sel);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition:
      transform 150ms ease-out,
      box-shadow 150ms ease-out;
  }

  .featured-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .featured-cover :global(img) {
    width: 100%;
    height: 230px;
    object-fit: cover;
    display: block;
  }

  .featured-body {
    padding: var(--sp-18);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .featured-pill {
    align-self: flex-start;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--saumon);
    color: #3b2a28;
    padding: 6px 11px;
    border-radius: var(--radius-pill);
  }

  .featured-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: 28px;
    line-height: 1.02;
    color: var(--espresso);
    margin: 0;
  }

  .featured-dek {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.6;
    color: #3d3833;
  }

  .featured-meta {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--truffle);
  }

  .everything-else-rule {
    display: flex;
    align-items: center;
    gap: var(--sp-10);
    padding: 4px var(--sp-20) var(--sp-14);
  }

  .everything-else-rule span {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--roquefort);
    white-space: nowrap;
  }

  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--rule-roquefort);
  }

  .thumb-rows {
    padding: 0 var(--gutter-card) var(--sp-22);
    display: flex;
    flex-direction: column;
    gap: var(--sp-10);
  }

  .thumb-row {
    display: flex;
    gap: var(--sp-14);
    background: var(--creme);
    border: 1px solid var(--fleur-de-sel);
    border-radius: var(--radius-grid-card);
    padding: 12px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 150ms ease-out;
  }

  .thumb-row:hover {
    box-shadow: var(--shadow-hover);
  }

  .thumb {
    width: 100px;
    height: 126px;
    flex-shrink: 0;
    border-radius: var(--radius-thumb-sm);
    overflow: hidden;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 2px;
  }

  .thumb-meta {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--truffle);
  }

  .thumb-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 20px;
    line-height: 1.08;
    color: var(--espresso);
  }

  .thumb-dek {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.5;
    color: #6b635c;
  }

  @media (min-width: 900px) {
    .archive-header,
    .featured-wrap,
    .everything-else-rule,
    .thumb-rows {
      max-width: 1120px;
      margin-inline: auto;
      padding-inline: var(--gutter-desktop);
    }

    .archive-header {
      padding-block: 32px 40px;
    }

    .archive-title {
      font-size: 52px;
    }
  }
</style>

