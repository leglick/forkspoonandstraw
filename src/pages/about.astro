---
// Start-here picks are specific posts the user asked for by name, not an
// auto-generated pick per category.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import headerPhoto from '../header_final.jpeg';

const allPosts = await getCollection('posts');
const startHereSlugs = [
  'touloused-confused-my-coup-de-coeur-restaurants',
  'my-first-month-in-toulouse',
  'ello-and-au-revoir-a-year-s-tapif-recap',
];
const startHere = startHereSlugs
  .map((slug) => allPosts.find((p) => p.data.slug === slug))
  .filter((p) => p !== undefined);

const facts = [
  { label: 'Currently in', value: 'Toulouse (7 years and counting!)' },
  { label: 'Always ordering', value: 'the second glass' },
  { label: 'My ideal weekend', value: 'Pyrenees or brunch, no in-between' },
  { label: 'French level', value: 'dreams in franglais' },
];
---

<BaseLayout title="About · Fork Spoon & Straw" description="American, in Toulouse." mastheadVariant="default">
  <section class="about-hero">
    <div class="hero-top">
      <h1 class="about-greeting">Bonjour,<br />c&rsquo;est <em>lele</em>.</h1>
      <Image class="portrait" src={headerPhoto} alt="" width={800} height={1067} />
    </div>
    <p class="about-copy">
      I&rsquo;ve always believed that food is the front door to any culture. Turns out
      I&rsquo;ve been walking through that door as often as I can since January 2017, when I
      stepped off a plane in Paris for a semester abroad and realized my life was about to split
      into &ldquo;before France&rdquo; and &ldquo;after France.&rdquo;
    </p>
    <p class="about-copy">
      I grew up in Los Angeles, went to Skidmore College in upstate New York (double major in
      Health &amp; Exercise Science and French, a combination that only makes sense if you know
      me), and spent most of college quietly plotting how to get back to France. It worked.
      After graduating in 2018, I landed in the Alps near Nice teaching English to high schoolers,
      which sounds romantic until you realize your entire social life revolves around a town with
      one brasserie and a ski lift.
    </p>
    <p class="about-copy">
      In September 2019, I took a job (and a leap of faith) and bought a one-way ticket to Toulouse. I told everyone it
      was for the career opportunity. It was also for the <em>marchés</em>, the <em>terrasses</em>, the Garonne
      at golden hour, and the fact that people here take <em>apéro</em> seriously. Seven years
      later, I&rsquo;m still working in Communications and Marketing, I&rsquo;m still here in{' '}
      <em>la Ville Rose</em>, and I&rsquo;m still discovering new <em>pépites</em> around every
      corner.
    </p>
    <p class="about-copy">
      These days you&rsquo;ll find me exploring the city, cycling through the Pyrenees, or
      standing in front of a cheese counter looking confident while internally panicking about
      which <em>tomme</em> to pick.
    </p>
    <p class="about-copy">
      This blog is where I keep the restaurants that made me close my eyes
      mid-bite, the trips that turned into stories, the recipes I actually cook at home, and the
      very specific chaos of being an American building a life in <em>franglais</em>,{' '}
      <em>bien sûr</em>!
    </p>
    <p class="about-signoff">xx lele</p>
  </section>

  <div class="fact-list">
    {
      facts.map((f) => (
        <div class="fact-row">
          <span>{f.label}</span>
          <span class="fact-value">{f.value}</span>
        </div>
      ))
    }
  </div>

  <div class="start-here-wrap">
    <div class="start-here">
      <span class="start-label">Start here</span>
      <h2 class="start-title">Three posts that explain the whole thing</h2>
      <div class="start-links">
        {
          startHere.map((post, i) => (
            <a href={`/posts/${post.data.slug}`}>
              {i + 1} &nbsp; {post.data.title}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <ContactBlock />
</BaseLayout>

<style>
  /* Full-bleed creme "paper" behind the capped text column -- see the same
     trick on PostLayout's .post; otherwise this reads as a narrow island
     floating in the sand background on wide desktops. */
  .about-hero {
    position: relative;
    padding: var(--sp-22) var(--gutter-text) var(--sp-20);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-hero::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--creme);
    z-index: -1;
  }

  .about-greeting {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.035em;
    font-size: 40px;
    line-height: 0.98;
    color: var(--espresso);
    margin: 0;
  }

  .about-greeting em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--paprika);
  }

  .hero-top {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .portrait {
    width: 100%;
    height: 330px;
    border-radius: var(--radius-card);
    object-fit: cover;
    object-position: 50% 30%;
  }

  .about-copy {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.68;
    color: var(--cacao);
  }

  .about-copy em {
    color: var(--paprika);
  }

  .about-signoff {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 28px;
    color: var(--paprika);
    margin-top: var(--sp-8);
  }

  .fact-list {
    position: relative;
    padding: 0 var(--gutter-text) var(--sp-20);
    display: flex;
    flex-direction: column;
  }

  .fact-list::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--creme);
    z-index: -1;
  }

  .fact-row {
    display: flex;
    justify-content: space-between;
    padding: 14px 0;
    border-top: 1px solid var(--rule-roquefort);
    font-family: var(--font-sans);
    font-size: 15px;
    color: #3d3833;
  }

  .fact-row:last-child {
    border-bottom: 1px solid var(--rule-roquefort);
  }

  .fact-value {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--roquefort-ink);
  }

  .start-here-wrap {
    padding: var(--sp-20) var(--gutter-card) var(--sp-22);
  }

  .start-here {
    border-radius: var(--radius-card);
    background: var(--creme);
    border: 1px solid var(--fleur-de-sel);
    border-left: 3px solid var(--saumon);
    padding: var(--sp-20);
    display: flex;
    flex-direction: column;
    gap: var(--sp-10);
  }

  .start-label {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paprika);
  }

  .start-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.025em;
    font-size: 22px;
    line-height: 1.1;
    color: var(--espresso);
    margin: 0;
  }

  .start-links {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding-top: var(--sp-4);
  }

  .start-links a {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--roquefort-ink);
    text-decoration: none;
  }

  @media (min-width: 900px) {
    .about-hero,
    .fact-list {
      max-width: var(--measure);
      margin-inline: auto;
      padding-inline: 0;
    }

    .start-here-wrap {
      max-width: var(--measure);
      margin-inline: auto;
      padding-inline: 0;
    }

    /* Photo sits beside the greeting instead of its own full-width row. */
    .hero-top {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }

    .about-greeting {
      flex: 1;
      font-size: 56px;
    }

    /* Matches the source's own 3:4 ratio so cover has nothing awkward to
       crop -- just smaller now that it sits next to the greeting. */
    .portrait {
      width: 240px;
      height: 320px;
      flex-shrink: 0;
    }
  }
</style>
